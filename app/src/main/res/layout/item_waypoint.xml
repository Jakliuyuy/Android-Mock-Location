<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MockLoc.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvWaypointIndex"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="@color/md_theme_primaryContainer"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/md_theme_onPrimaryContainer"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWaypointName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/md_theme_onSurface" />

            <TextView
                android:id="@+id/tvWaypointCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/md_theme_onSurfaceVariant" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMoveUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_move_up"
            android:src="@drawable/ic_arrow_up_24"
            app:tint="@color/md_theme_onSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnMoveDown"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_move_down"
            android:src="@drawable/ic_arrow_down_24"
            app:tint="@color/md_theme_onSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnRemoveWaypoint"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_remove_waypoint"
            android:src="@drawable/ic_delete_24"
            app:tint="@color/md_theme_error" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

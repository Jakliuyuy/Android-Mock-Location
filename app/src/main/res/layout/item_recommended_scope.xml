<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MockLoc.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvScopeAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/md_theme_onSurface" />

            <TextView
                android:id="@+id/tvScopeCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/md_theme_onSurfaceVariant" />

            <TextView
                android:id="@+id/tvScopeInstallStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvScopePackageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/md_theme_primary" />

            <TextView
                android:id="@+id/tvScopeSystemBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/status_warning_container"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/badge_scope_only"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/status_warning"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnCopyPackage"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_copy_package"
                android:src="@drawable/ic_copy_24"
                app:tint="@color/md_theme_onSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvScopeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/md_theme_onSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
